POSTGRES_PASSWORD=replace-with-long-url-safe-random-password
VISIONINSIGHT_ENV=development
VISIONINSIGHT_COOKIE_SECURE=false
VISIONINSIGHT_PUBLIC_BASE_URL=http://localhost:8000
VISIONINSIGHT_MODEL_LICENSE_CLEARED=false
VISIONINSIGHT_MAX_UPLOAD_MB=1000
VISIONINSIGHT_MAX_DURATION_SEC=7200
VISIONINSIGHT_MAX_VIDEO_PIXELS=8294400
VISIONINSIGHT_MAX_VIDEO_FPS=60
VISIONINSIGHT_MAX_VIDEO_FRAMES=432000
VISIONINSIGHT_MAX_PROCESSING_SECONDS=7200
VISIONINSIGHT_MAX_DERIVED_MB=2048
VISIONINSIGHT_MIN_FREE_DISK_MB=1024

# Leave billing disabled until Paddle has approved the account and domain.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_DEVELOPER_PRICE_ID=
PADDLE_TEAM_PRICE_ID=
PADDLE_DEVELOPER_DISPLAY_PRICE=
PADDLE_TEAM_DISPLAY_PRICE=

# Publish reviewed legal pages before enabling checkout.
VISIONINSIGHT_TERMS_URL=
VISIONINSIGHT_PRIVACY_URL=
VISIONINSIGHT_BUSINESS_EMAIL=

# Required for production account verification.
VISIONINSIGHT_SMTP_HOST=
VISIONINSIGHT_SMTP_PORT=465
VISIONINSIGHT_SMTP_USER=
VISIONINSIGHT_SMTP_PASSWORD=
VISIONINSIGHT_SMTP_FROM=
